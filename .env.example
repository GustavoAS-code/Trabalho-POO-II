# Configuracoes do Banco de Dados PostgreSQL (Docker)
POSTGRES_USER=locadora_user
POSTGRES_PASSWORD=locadora_pass
POSTGRES_DB=locadora_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Configuracoes da API Flask
API_HOST=0.0.0.0
API_PORT=5000
# URL usada pelo Cliente Desktop PySide6 (troque localhost pelo IP do servidor em rede remota)
LOCADORA_API_URL=http://127.0.0.1:5000